# agents7 framework — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is
# gitignored; this template is committed. Never commit secrets.
# Every variable below is optional — the framework runs on its
# defaults when they are unset.

# ── Ollama provider ─────────────────────────────────────────────────
# Default model used only when code falls back to OllamaSettings.
# Agents usually set their own model in code/YAML, so leave unset.
# OLLAMA_MODEL_NAME=qwen3

# ── OpenAI-compatible provider (e.g. DeepSeek, vLLM, LM Studio) ──────
# Configure an external OpenAI-compatible API entirely from the
# environment. Any LLMEngine(provider="openai_compat") argument left
# unset falls back to these. Per field precedence:
#   explicit arg → OPENAI_COMPAT_* → the openai SDK's own fallback.
# OPENAI_COMPAT_MODEL_NAME=deepseek-chat
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_API_KEY=sk-...            # SECRET

# ── OpenAI provider (openai SDK implicit fallbacks) ─────────────────
# Used by the openai_compat provider when the OPENAI_COMPAT_* vars
# above are unset.
# OPENAI_API_KEY=sk-...                   # SECRET
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic / Claude provider ─────────────────────────────────────
# Read implicitly by the anthropic SDK for provider="anthropic".
# ANTHROPIC_API_KEY=sk-ant-...            # SECRET

# ── Batch tuning ────────────────────────────────────────────────────
# Max concurrent LLM requests in async batch processing (default 5).
# BATCH_MAX_CONCURRENT=5
